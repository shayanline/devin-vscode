{
  "name": "devin-vscode",
  "displayName": "Devin for VS Code",
  "description": "A native chat panel for the Devin CLI, powered by the Agent Client Protocol. Streaming replies, per workspace sessions, and trackable diffs.",
  "version": "0.6.37",
  "publisher": "shayanline",
  "author": "Shayan Khaksar",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shayanline/devin-vscode.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "devin",
    "devin-cli",
    "acp",
    "agent",
    "chat",
    "ai"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devin",
          "title": "Devin",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "devin": [
        {
          "type": "webview",
          "id": "devin.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "devin.newSession",
        "title": "New Session",
        "category": "Devin",
        "icon": "$(add)"
      },
      {
        "command": "devin.showSessions",
        "title": "Show Sessions",
        "category": "Devin",
        "icon": "$(history)"
      },
      {
        "command": "devin.focusChat",
        "title": "Open Chat",
        "category": "Devin",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "devin.cancel",
        "title": "Cancel Current Turn",
        "category": "Devin",
        "icon": "$(stop-circle)"
      },
      {
        "command": "devin.runSetup",
        "title": "Run Setup",
        "category": "Devin",
        "icon": "$(gear)"
      },
      {
        "command": "devin.showInfo",
        "title": "About / Status",
        "category": "Devin",
        "icon": "$(info)"
      },
      {
        "command": "devin.acceptChange",
        "title": "Accept Change",
        "category": "Devin",
        "icon": "$(check)"
      },
      {
        "command": "devin.rejectChange",
        "title": "Reject Change",
        "category": "Devin",
        "icon": "$(discard)"
      },
      {
        "command": "devin.acceptAllChanges",
        "title": "Accept All Changes",
        "category": "Devin",
        "icon": "$(check-all)"
      },
      {
        "command": "devin.rejectAllChanges",
        "title": "Reject All Changes",
        "category": "Devin",
        "icon": "$(discard)"
      },
      {
        "command": "devin.openChangeDiff",
        "title": "Open Diff",
        "category": "Devin",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "devin.acceptChange",
          "when": "false"
        },
        {
          "command": "devin.rejectChange",
          "when": "false"
        },
        {
          "command": "devin.openChangeDiff",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "devin.newSession",
          "when": "view == devin.chatView",
          "group": "navigation@1"
        }
      ],
      "scm/title": [
        {
          "command": "devin.acceptAllChanges",
          "when": "scmProvider == devin",
          "group": "navigation@1"
        },
        {
          "command": "devin.rejectAllChanges",
          "when": "scmProvider == devin",
          "group": "navigation@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "devin.acceptChange",
          "when": "scmProvider == devin",
          "group": "inline@1"
        },
        {
          "command": "devin.rejectChange",
          "when": "scmProvider == devin",
          "group": "inline@2"
        },
        {
          "command": "devin.openChangeDiff",
          "when": "scmProvider == devin",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Devin",
      "properties": {
        "devin.cliPath": {
          "type": "string",
          "default": "devin",
          "description": "Path to the Devin CLI executable. Use an absolute path if it is not on your PATH."
        },
        "devin.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model alias to request for new sessions (e.g. auto, sonnet, opus, gpt). Empty uses the CLI default (Adaptive)."
        },
        "devin.defaultMode": {
          "type": "string",
          "enum": [
            "accept-edits",
            "ask",
            "plan",
            "bypass"
          ],
          "enumDescriptions": [
            "Code: write and edit code (auto-approves edits in the workspace)",
            "Ask: answer questions without code changes",
            "Plan: plan changes before implementing (read-only)",
            "Bypass: auto-approve all tool calls"
          ],
          "default": "accept-edits",
          "description": "Session mode for new sessions."
        },
        "devin.autoResumeLast": {
          "type": "boolean",
          "default": false,
          "description": "When the chat opens, resume the last session used in this workspace."
        },
        "devin.idleSessionKeepAliveMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "How long to keep an idle live session (waiting for you) alive before it is automatically exited. Running sessions are never auto-exited. Set to 0 to keep idle sessions alive indefinitely."
        },
        "devin.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show the agent's reasoning/thinking stream in the chat."
        },
        "devin.thinking.style": {
          "type": "string",
          "enum": [
            "collapsed",
            "fixedScrolling"
          ],
          "enumDescriptions": [
            "Show a collapsed 'Thinking…' header; expand to read the reasoning",
            "Show a live, fixed-height peek of the latest reasoning while it streams, then collapse it"
          ],
          "default": "fixedScrolling",
          "description": "How the reasoning stream is displayed while the agent is thinking."
        },
        "devin.incrementalRendering.animationStyle": {
          "type": "string",
          "enum": [
            "off",
            "fade",
            "rise",
            "blur",
            "scale",
            "slide"
          ],
          "default": "rise",
          "description": "Entrance animation for each response part as it streams in."
        },
        "devin.editRequests": {
          "type": "string",
          "enum": [
            "inline",
            "hover",
            "input",
            "none"
          ],
          "enumDescriptions": [
            "Click a sent message to edit it in place",
            "Show an edit button on hover; editing happens in place",
            "Edit a sent message in the main composer at the bottom",
            "Disable editing sent messages"
          ],
          "default": "inline",
          "description": "How to edit a previously sent request. Editing rewinds the conversation to that point and re-runs (requires the Devin CLI revert capability)."
        },
        "devin.checkpoints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a Restore Checkpoint action on each turn to rewind the workspace and conversation to that point (requires the Devin CLI revert capability)."
        },
        "devin.checkpoints.showFileChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show a summary of files changed at the end of each turn."
        },
        "devin.editing.confirmEditRequestRemoval": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before an edit or restore discards later turns that made file edits."
        },
        "devin.verbose": {
          "type": "boolean",
          "default": true,
          "description": "Show request and response timestamps on hover in the transcript."
        },
        "devin.progressBorder.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Animate a highlight around the input while Devin is working."
        },
        "devin.contextUsage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the context-window usage indicator in the input toolbar."
        },
        "devin.implicitContext.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Include the active editor file (or its selection) as implicit context, shown as a pill in the composer. Toggle it per message from the pill."
        },
        "devin.inlineReferences.style": {
          "type": "string",
          "enum": [
            "box",
            "link"
          ],
          "enumDescriptions": [
            "Render file and symbol references in replies as bordered chips",
            "Render them as plain text links"
          ],
          "default": "box",
          "description": "How file and symbol references inside replies are rendered."
        },
        "devin.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to `devin acp` when starting a session."
        },
        "devin.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra environment variables for the Devin CLI process (e.g. proxy settings)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "node esbuild.js",
    "check-types": "tsc --noEmit",
    "pretest": "npm run compile",
    "test": "node --test scripts/*.test.js",
    "harness": "node scripts/webview-harness.js",
    "preview": "npm run compile && node scripts/preview.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.92.0",
    "@vscode/codicons": "^0.0.36",
    "esbuild": "^0.23.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0"
  }
}
